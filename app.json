{
  "expo": {
    "name": "KoruApp",
    "slug": "KoruApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets//images/images/koruApp for navigation.png",
    "scheme": "koruapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/images/koruApp for navigation.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CALL_PHONE"],
      "package": "com.koru.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Koru necesita el micrófono para escucharte.",
          "speechRecognitionPermission": "Koru necesita reconocimiento de voz."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      [
        "@react-native-firebase/app-check",
        {
          "androidProvider": "playIntegrity"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "45e937d1-bf91-47f8-a33c-d22ff609b2a4"
      }
    },
    "owner": "isaac080"
  }
}
